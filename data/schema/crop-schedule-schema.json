{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "crop-schedule",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["crop", "nodeSeq", "daysAfterSowing", "operationType", "name", "description", "source", "category"],
    "additionalProperties": false,
    "properties": {
      "crop": { "type": "string", "minLength": 1 },
      "nodeSeq": { "type": "integer", "minimum": 1 },
      "daysAfterSowing": { "type": "integer", "minimum": 0 },
      "operationType": { "enum": ["pesticide", "fertilizer", "irrigation", "harvest", "sowing", "emergence", "other"] },
      "name": { "type": "string", "minLength": 1 },
      "description": { "type": "string" },
      "source": { "type": "string", "minLength": 1 },
      "category": { "enum": ["grain", "vegetable", "cashCrop", "fruit", "oilCrop", "forage", "medicinal", "tea", "other"] }
    }
  }
}