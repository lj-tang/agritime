{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "data-quality-report",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["tableName", "checkType", "result", "sourceCoverage", "generatedAt"],
    "additionalProperties": false,
    "properties": {
      "tableName": { "type": "string", "minLength": 1 },
      "checkType": { "enum": ["schema", "contract", "prediction", "increment"] },
      "result": { "enum": ["pass", "fail"] },
      "failureDetails": { "type": "array", "items": { "type": "string" } },
      "sourceCoverage": { "type": "number", "minimum": 0, "maximum": 100 },
      "generatedAt": { "type": "string", "minLength": 1 }
    },
    "if": { "properties": { "result": { "const": "fail" } } },
    "then": { "required": ["failureDetails"] }
  }
}