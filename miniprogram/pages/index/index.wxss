.page { padding: 24rpx; background: #f7f4ec; min-height: 100vh; box-sizing: border-box; }
.hero { padding: 12rpx 8rpx 28rpx; }
.hero-title { display: block; font-size: 44rpx; font-weight: 700; color: #2f4f3a; }
.hero-sub { display: block; margin-top: 8rpx; font-size: 26rpx; color: #7a7f78; }

.card { background: #fff; border-radius: 20rpx; padding: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,.05); }
.field { margin-bottom: 28rpx; }
.label { display: block; font-size: 26rpx; color: #5b635c; margin-bottom: 12rpx; }
.input, .picker {
  height: 80rpx; line-height: 80rpx; padding: 0 20rpx;
  background: #f4f2ec; border-radius: 12rpx; font-size: 28rpx; color: #2b2f2c;
}
.ghost-btn {
  margin-top: 14rpx; font-size: 24rpx; color: #2f6b45;
  background: #e9f2ea; border-radius: 999rpx;
}
.hint { display: block; margin-top: 12rpx; font-size: 24rpx; color: #7a7f78; line-height: 1.6; }
.primary-btn { margin-top: 8rpx; background: #2f6b45; color: #fff; border-radius: 12rpx; font-size: 30rpx; }
.tip { margin-top: 24rpx; text-align: center; font-size: 22rpx; color: #9aa09b; }
