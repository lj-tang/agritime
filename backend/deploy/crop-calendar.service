[Unit]
Description=Crop Calendar API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/crop-calendar
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8 -cp build/classes com.cropcalendar.Server
Restart=on-failure
RestartSec=5
StandardOutput=append:/opt/crop-calendar/server.log
StandardError=append:/opt/crop-calendar/server.log

[Install]
WantedBy=multi-user.target