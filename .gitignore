# 构建产物
backend/build/
*.class

# 签字工作表生成器产物（每次拉 DEM 重新生成，不入库）
data/geo-baseline-computed.json

# 运行时数据（账号库等，含密码摘要，绝不入库）
backend/var/
# 服务端以仓库根为工作目录时，运行时会写到这里（缓存、传感器、同步档案）
/var/

# 运行时文件
*.log
*.pid
# 部署时手工留的页面备份
*.bak

# 工具临时数据（CodeArts 索引 / 抓取数据集，非源码）
.codeartsdoer/temp/
.codeartsdoer/.codebase/

# 智能体工作目录（本地记忆，不入库）
.workbuddy/
.workbuddy-ai/

# 依赖与系统文件
node_modules/
.DS_Store
Thumbs.db
# 服务器本地放的 JDBC 驱动（mysql/mariadb connector，运行时下载，不入库）
/lib/

# 本地开发工具与临时脚本（依赖、截图、调试脚本，不入库）
.dev/

# 小程序构建产物（由 miniprogram/scripts/sync-shared.js 生成）
miniprogram/utils/shared/
