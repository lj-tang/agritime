# 构建产物
backend/build/
*.class

# 运行时数据（账号库等，含密码摘要，绝不入库）
backend/var/

# 运行时文件
*.log
*.pid

# 工具临时数据（CodeArts 索引 / 抓取数据集，非源码）
.codeartsdoer/temp/
.codeartsdoer/.codebase/file-index.db

# 智能体工作目录（本地记忆，不入库）
.workbuddy/
.workbuddy-ai/

# 依赖与系统文件
node_modules/
.DS_Store
Thumbs.db

# 本地开发工具与临时脚本（依赖、截图、调试脚本，不入库）
.dev/

# 小程序构建产物（由 miniprogram/scripts/sync-shared.js 生成）
miniprogram/utils/shared/
